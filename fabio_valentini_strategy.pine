//@version=5
indicator("Fabio Valentini – IVB (Inversione di Breve)", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────
grpTrend = "Trend Settings"
emaF     = input.int(9,   "EMA Fast",         minval=1, group=grpTrend)
emaM     = input.int(21,  "EMA Medium",        minval=1, group=grpTrend)
emaS     = input.int(200, "EMA Slow (Trend)",  minval=1, group=grpTrend)

grpIvb   = "IVB Candle Detection"
wickRatio  = input.float(2.0, "Min Wick/Body Ratio (Pin Bar)", minval=1.0, step=0.1, group=grpIvb,
             tooltip="Lower wick must be this many times bigger than body for a bullish pin bar (vice versa for bearish)")
engulfPct  = input.float(100.0, "Engulf % (body must cover)", minval=50.0, step=5.0, group=grpIvb,
             tooltip="Current candle body must cover this % of the previous candle body to be an engulfing")

grpPb    = "Pullback Zone"
pullZone = input.float(0.5, "EMA Touch Zone (ATR multiplier)", minval=0.1, step=0.1, group=grpPb,
           tooltip="How close price must come to EMA 21 to count as a pullback")

grpRisk  = "Risk Management"
rrRatio  = input.float(2.0, "Risk / Reward Ratio", minval=0.5, step=0.5, group=grpRisk)
slBuffer = input.float(0.2, "SL Buffer (ATR multiplier)", minval=0.0, step=0.1, group=grpRisk,
           tooltip="Extra buffer added beyond candle extreme for SL")

grpDisp  = "Display"
showEmas = input.bool(true, "Show EMAs",             group=grpDisp)
showBg   = input.bool(true, "Show Trend Background", group=grpDisp)
showLbls = input.bool(true, "Show SL / TP Labels",   group=grpDisp)

// ─────────────────────────────────────────────
//  CALCULATIONS
// ─────────────────────────────────────────────
fast = ta.ema(close, emaF)
med  = ta.ema(close, emaM)
slow = ta.ema(close, emaS)
atr  = ta.atr(14)

// ── Trend context ──────────────────────────
upTrend   = close > slow
downTrend = close < slow

// ── Pullback: price touched EMA 21 zone ───
touchedEmaUp   = math.abs(low  - med) <= atr * pullZone or (low <= med and close >= med)
touchedEmaDown = math.abs(high - med) <= atr * pullZone or (high >= med and close <= med)

// ── IVB candle patterns ───────────────────
bodySize   = math.abs(close - open)
candleSize = high - low

// Bullish Pin Bar: long lower wick, small body near top
lowerWick    = open > close ? close - low : open - low
upperWick    = open > close ? high - open : high - close
bullPin      = lowerWick >= bodySize * wickRatio and close > open and lowerWick > upperWick

// Bearish Pin Bar: long upper wick, small body near bottom
bullUpperWick = open > close ? high - open : high - close
bearLowerWick = open > close ? close - low  : open  - low
bearPin       = bullUpperWick >= bodySize * wickRatio and close < open and bullUpperWick > bearLowerWick

// Bullish Engulfing: current bullish body covers previous bearish body
prevBodyTop    = math.max(open[1], close[1])
prevBodyBottom = math.min(open[1], close[1])
prevBodySz     = prevBodyTop - prevBodyBottom
bullEngulf     = close > open and open[1] > close[1] and
                 close >= prevBodyTop  and open <= prevBodyBottom and prevBodySz > 0

// Bearish Engulfing: current bearish body covers previous bullish body
bearEngulf     = close < open and close[1] > open[1] and
                 open >= prevBodyTop  and close <= prevBodyBottom and prevBodySz > 0

// ── IVB signal = trend + pullback + reversal candle ──
ivbLong  = upTrend   and touchedEmaUp   and (bullPin or bullEngulf)
ivbShort = downTrend and touchedEmaDown and (bearPin or bearEngulf)

// ── SL / TP ──────────────────────────────
// Long: SL below candle low, TP at R:R multiple
longSL   = low  - atr * slBuffer
longTP   = close + (close - longSL) * rrRatio

// Short: SL above candle high, TP at R:R multiple
shortSL  = high + atr * slBuffer
shortTP  = close - (shortSL - close) * rrRatio

// ─────────────────────────────────────────────
//  PLOTS — EMAs
// ─────────────────────────────────────────────
plot(showEmas ? fast : na, "EMA 9",   color=color.new(color.blue,   0), linewidth=1)
plot(showEmas ? med  : na, "EMA 21",  color=color.new(color.orange, 0), linewidth=2)
plot(showEmas ? slow : na, "EMA 200", color=color.new(color.red,    0), linewidth=2)

// ── Trend Background ─────────────────────
bgcolor(showBg and upTrend   ? color.new(color.green, 93) : na, title="Up Trend BG")
bgcolor(showBg and downTrend ? color.new(color.red,   93) : na, title="Down Trend BG")

// ── Entry arrows ─────────────────────────
plotshape(ivbLong,  "IVB Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.normal, text="IVB")
plotshape(ivbShort, "IVB Short", shape.triangledown,  location.abovebar, color.new(color.red,   0), size=size.normal, text="IVB")

// ── IVB pattern type label ───────────────
patternLong  = bullPin ? "Pin Bar" : "Engulfing"
patternShort = bearPin ? "Pin Bar" : "Engulfing"

if ivbLong and showLbls
    label.new(bar_index, low - atr * 0.5, patternLong,
              color=color.new(color.green, 20), textcolor=color.white,
              style=label.style_label_up, size=size.tiny)

if ivbShort and showLbls
    label.new(bar_index, high + atr * 0.5, patternShort,
              color=color.new(color.red, 20), textcolor=color.white,
              style=label.style_label_down, size=size.tiny)

// ── SL / TP Labels ───────────────────────
_p(v) => str.tostring(math.round(v, 2))

if ivbLong and showLbls
    label.new(bar_index + 1, longTP, "TP " + _p(longTP) + "  [" + _p(rrRatio) + "R]",
              color=color.new(color.green, 10), textcolor=color.white,
              style=label.style_label_left, size=size.small)
    label.new(bar_index + 1, longSL, "SL " + _p(longSL),
              color=color.new(color.red, 10),   textcolor=color.white,
              style=label.style_label_left, size=size.small)

if ivbShort and showLbls
    label.new(bar_index + 1, shortTP, "TP " + _p(shortTP) + "  [" + _p(rrRatio) + "R]",
              color=color.new(color.green, 10), textcolor=color.white,
              style=label.style_label_left, size=size.small)
    label.new(bar_index + 1, shortSL, "SL " + _p(shortSL),
              color=color.new(color.red, 10),   textcolor=color.white,
              style=label.style_label_left, size=size.small)

// ─────────────────────────────────────────────
//  INFO TABLE
// ─────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 6,
                         border_color=color.gray, border_width=1,
                         frame_color=color.gray, frame_width=1)

if barstate.islast
    trendTxt  = upTrend ? "▲ BULL" : downTrend ? "▼ BEAR" : "── NEUTRAL"
    trendCol  = upTrend ? color.green : downTrend ? color.red : color.gray
    sigTxt    = ivbLong ? "IVB LONG ▲" : ivbShort ? "IVB SHORT ▼" : "–"
    sigCol    = ivbLong ? color.green  : ivbShort  ? color.red     : color.gray
    patTxt    = ivbLong ? patternLong  : ivbShort  ? patternShort  : "–"
    slTxt     = ivbLong ? _p(longSL)  : ivbShort  ? _p(shortSL)   : "–"
    tpTxt     = ivbLong ? _p(longTP)  : ivbShort  ? _p(shortTP)   : "–"

    table.cell(t, 0, 0, "TREND",   text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(t, 1, 0, trendTxt,  text_color=trendCol,    bgcolor=color.new(color.black, 20))
    table.cell(t, 0, 1, "SIGNAL",  text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(t, 1, 1, sigTxt,    text_color=sigCol,      bgcolor=color.new(color.black, 20))
    table.cell(t, 0, 2, "PATTERN", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(t, 1, 2, patTxt,    text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 0, 3, "ENTRY",   text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(t, 1, 3, _p(close), text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(t, 0, 4, "SL",      text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(t, 1, 4, slTxt,     text_color=color.red,   bgcolor=color.new(color.black, 20))
    table.cell(t, 0, 5, "TP",      text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(t, 1, 5, tpTxt,     text_color=color.green, bgcolor=color.new(color.black, 20))

// ─────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────
alertcondition(ivbLong,  "IVB Long",  "Valentini IVB: LONG setup detected")
alertcondition(ivbShort, "IVB Short", "Valentini IVB: SHORT setup detected")
